# Copie para .env: cp .env.example .env
# VPS: frontend em http://localhost:5173

# REST API via Kong Gateway
VITE_API_BASE_URL=http://localhost:8000

# Keycloak OIDC (password grant no token endpoint)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/crash-game
VITE_OIDC_CLIENT_ID=crash-game-client

# Games WebSocket (conexao direta, nao passa pelo Kong)
VITE_WS_URL=http://localhost:4001
