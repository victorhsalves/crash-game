# Build-time do Vite no Docker (usa PUBLIC_HOST do .env na raiz do projeto).
# Dev local com Vite: cp .env.example .env
# VPS: mantenha PUBLIC_HOST=147.93.66.151 no .env da raiz
# Local docker: edite .env na raiz para PUBLIC_HOST=localhost e rebuild do frontend
#
# Docker: WS passa pelo nginx do frontend (porta 5173) — nao expor 4001 na VPS.
# Vite dev: conexao direta ao games na porta 4001.

VITE_API_BASE_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/crash-game
VITE_OIDC_CLIENT_ID=crash-game-client
VITE_WS_URL=http://localhost:5173
