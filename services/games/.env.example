# Usado pelo docker compose (env_file) e como template para dev local.
# Dev local: altere PUBLIC_HOST no .env da raiz para localhost e use frontend/.env.local.example
#
# Portas (docker-compose.yml): frontend 5173, kong 8000, keycloak 8080, games 4001, wallets 4002

PORT=4001
ROUND_BETTING_DURATION_SECONDS=10
ROUND_CRASHED_DURATION_SECONDS=10
CURVE_GROWTH_FACTOR=0.23
CLIENT_SEED=crash-challenge-v1
HASH_CHAIN_LENGTH=10000
MAX_CRASH_POINT=1000

DATABASE_URL=postgresql://admin:admin@postgres:5432/games
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
RABBITMQ_EXCHANGE=crash.events

KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game,http://147.93.66.151:8080/realms/crash-game
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/crash-game/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=crash-game-client

KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
