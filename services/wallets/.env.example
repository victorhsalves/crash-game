# Usado pelo docker compose (env_file) e como template para dev local.
# Dev local: cp .env.example .env
#
# Portas expostas (docker-compose.yml):
#   frontend 5173, kong 8000, keycloak 8080, games 4001, wallets 4002, postgres 3500

PORT=4002
DATABASE_URL=postgresql://admin:admin@postgres:5432/wallets
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
RABBITMQ_EXCHANGE=crash.events

KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game,http://147.93.66.151:8080/realms/crash-game
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/crash-game/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=crash-game-client

INITIAL_WALLET_BALANCE_CENTS=2000
ENABLE_INTERNAL_TEST_ROUTES=true
